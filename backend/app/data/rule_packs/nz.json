{
  "id": "securo/rules-nz",
  "name": {
    "en": "New Zealand",
    "pt-BR": "Nova Zelândia"
  },
  "description": {
    "en": "Common merchants and transfer patterns, mapped to the default categories.",
    "pt-BR": "Estabelecimentos e padrões de transferência comuns, mapeados para as categorias padrão."
  },
  "version": "1.0.0",
  "repository": "https://github.com/nagelm/securo",
  "license": "AGPL-3.0-only",
  "min_securo_version": "0.19.0",
  "contributes": {
    "rules": [
      {
        "key": "nz-supermarkets",
        "name": "NZ supermarkets",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "WOOLWORTHS|COUNTDOWN|NEW WORLD|PAK ?'?N ?'?SAVE(?! ?FUEL)|FOUR SQUARE|FRESH ?CHOICE|SUPERVALUE|\\bCOSTCO\\b(?! ?FUEL)|\\bFARRO\\b|RAEWARD|MOORE WILSON|COMMONSENSE ORGANICS|\\bBIN INN\\b|NIGHT ?'?N'? ?DAY|ON THE SPOT|HUCKLEBERRY|\\bSUPIE\\b"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "groceries"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-liquor-stores",
        "name": "NZ liquor stores",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "LIQUORLAND|SUPER LIQUOR|LIQUOR KING|THIRSTY LIQUOR|GLENGARRY|BOTTLE[- ]?O\\b"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "groceries"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-food-delivery",
        "name": "NZ food delivery",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "UBER ?EATS|DOORDASH|MENULOG|DELIVEREASY"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "food"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-takeaway-and-cafe-chains",
        "name": "NZ takeaway and cafe chains",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "MCDONALD|\\bKFC\\b|BURGER KING|BURGER ?FUEL|\\bSUBWAY\\b|DOMINO|PIZZA HUT|HELL PIZZA|STARBUCKS|MUFFIN BREAK|COFFEE CULTURE|\\bMOJO\\b|CARL'?S JR|WENDY'?S|TACO BELL|NANDO'?S|LONE STAR|PITA PIT|ST PIERRE|COLUMBUS COFFEE|ROBERT HARRIS|ESQUIRES"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "food"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-fuel",
        "name": "NZ fuel",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "Z ENERGY|^Z |\\bBP\\b|\\bMOBIL\\b|\\bGULL\\b|WAITOMO|\\bNPD\\b|CALTEX|ALLIED PETROLEUM|TASMAN FUELS|MCKEOWN|PAK ?'?N ?'?SAVE ?FUEL|COSTCO ?FUEL"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "transport"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-public-transport",
        "name": "NZ public transport",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "METLINK|AT HOP|AUCKLAND TRANSPORT|SNAPPER|BEE CARD|KIWIRAIL|INTERCITY|\\bMETRO CARD\\b|MOTU MOVE|\\bBUSIT\\b|\\bBAYBUS\\b|\\bORBUS\\b|\\bGOBAY\\b|FULLERS|\\bDIDI\\b"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "transport"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-airlines-and-ferries",
        "name": "NZ airlines and ferries",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "\\bAIR ?N(EW )?Z(EALAND)?\\b|JETSTAR|SOUNDS AIR|AIR CHATHAMS|ORIGINAIR|BARRIER AIR|INTERISLANDER|BLUEBRIDGE"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "transport"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-parking",
        "name": "NZ parking",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "WILSON PARKING|PARKMATE|\\bCARE ?PARK|PAYBYPHONE|SMARTPARK|SECURE PARKING|TOURNAMENT PARKING"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "transport"
          }
        ],
        "priority": 10
      },
      {
        "key": "nz-vehicle-licensing-and-inspections",

        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "\\bNZTA\\b|NZ TRANSPORT AGENCY|WAKA KOTAHI|\\bVTNZ\\b|\\bVINZ\\b"
